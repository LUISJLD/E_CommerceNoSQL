# Ignore Python bytecode files
*.pyc
__pycache__/

# Ignore environment variables files
.env
.env.production
.env.local
.env.development
.env.test

# Artifacts
output.json
venv/
env/
ENV/
.venv/

# Django stuff:
*.log
*.pot
*.pyc
__pycache__/
local_settings.py
/staticfiles/

# Node.js/React stuff:
node_modules/
frontend/node_modules/
build/
dist/
.cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# CDK stuff:
cdk.out/
infrastructure/cdk.out/

# LocalStack data:
localstack_data/

# Lambda hot-reload: shared/ copies in each handler (generated by deploy.py)
lambdas/*/shared/

# Pip dependencies cache and per-handler copies (generated by deploy.py)
lambdas/_deps/
lambdas/_deps_installed
lambdas/*/_deps_installed
lambdas/*/redis/
lambdas/*/redis-*.dist-info/
lambdas/*/jwt/
lambdas/*/pyjwt-*.dist-info/
lambdas/*/bin/
lambdas/*/async_timeout*

# Testing:
.pytest_cache/
.coverage
htmlcov/
.tox/

# IDE and editors:
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files:
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Ignnore migration files
*/migrations/

