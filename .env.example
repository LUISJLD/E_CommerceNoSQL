# ============================================================================
# E-Commerce NoSQL Environment Configuration
# ============================================================================
# Copy this file to .env and fill in the actual values

# ─── VITE / FRONTEND ───────────────────────────────────────────────────────
# URL del API Gateway (LocalStack o AWS)
# En local con docker-compose: http://localhost:4566/restapis
# En producción AWS: https://xxxxx.execute-api.us-east-1.amazonaws.com/prod
VITE_API_URL=http://localhost:4566/restapis

# ID del API Gateway creado por CDK (obtenido del deploy output)
# Se usa en vite.config.ts para reescribir la URL del proxy
VITE_API_ID=local

# ─── AWS / CDK ─────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
AWS_REGION_NAME=us-east-1
AWS_DEFAULT_REGION=us-east-1

# ─── DYNAMODB ──────────────────────────────────────────────────────────────
# URL del endpoint DynamoDB (LocalStack o AWS)
DYNAMODB_ENDPOINT_URL=http://localhost:4566

# Nombre de la tabla DynamoDB
TABLE_NAME=Ecommerce

# ─── REDIS ────────────────────────────────────────────────────────────────
# URL de conexión a Redis
REDIS_URL=redis://localhost:6379/1

# TTL para caché general (segundos)
CACHE_TTL_SECONDS=60

# TTL para caché de carrito (segundos)
CART_TTL_SECONDS=300

# ─── LOCALSTACK ───────────────────────────────────────────────────────────
# Hostname de LocalStack en Docker (nombre del servicio)
LOCALSTACK_HOSTNAME=localstack

# Ejecutor de Lambda en LocalStack (local o docker)
LAMBDA_EXECUTOR=local

# ─── LOGGING / DEBUG ──────────────────────────────────────────────────────
DEBUG=True
LOG_LEVEL=INFO

# ─── APLICACIÓN ───────────────────────────────────────────────────────────
ENVIRONMENT=development
# ENVIRONMENT=production (para producción)

# ─── PORT FORWARDING ──────────────────────────────────────────────────────
# Puerto de frontend (Vite dev server)
FRONTEND_PORT=5173

# Puerto de backend Django
BACKEND_PORT=8000

# Puerto de LocalStack
LOCALSTACK_PORT=4566

# Puerto de DynamoDB local
DYNAMODB_PORT=8000

# Puerto de Redis
REDIS_PORT=6379
