# ============================================================================
# E-Commerce NoSQL — Variables de Entorno
# ============================================================================
# Copia este archivo a .env en la raíz del proyecto antes de ejecutar
# docker compose up.

# ─── REQUERIDO ─────────────────────────────────────────────────────────────
# Ruta absoluta al directorio del proyecto en tu máquina (host).
# Necesario para que LocalStack monte las Lambdas con hot-reload.
# Usar barras / incluso en Windows.
LAMBDA_HOST_PROJECT_PATH=C:/Users/TU_USUARIO/ruta/al/E_CommerceNoSQL

# ─── OPCIONALES (tienen defaults en docker-compose.yml) ────────────────────
# Estos valores se pueden sobreescribir si es necesario:
# CACHE_TTL_SECONDS=30
# CART_TTL_SECONDS=60
